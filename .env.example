# Copy to .env and fill in. Never commit .env.

# OpenAI: onboarding extraction, live-ingest parsing, embeddings
OPENAI_API_KEY=

# Bright Data: Web Unlocker zone + Web Scraper API datasets
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=hallway_unlocker
BRIGHTDATA_DATASET_LINKEDIN_PROFILES=
BRIGHTDATA_DATASET_LINKEDIN_JOBS=
BRIGHTDATA_DATASET_YOUTUBE_VIDEOS=
# Spend cap enforced by the budget guard (USD)
BRIGHTDATA_BUDGET_USD=40

# GitHub REST/GraphQL (profile + contribution heatmap); optional but avoids rate limits
GITHUB_TOKEN=

# FalkorDB (docker compose up -d)
FALKORDB_URL=redis://localhost:6379
GRAPH_NAME=hallway

# TrueForge agent (see README: Running the agent)
TRUEFORGE_URL=http://localhost:8790
# Shared secret TrueForge sends to /api/mcp (any long random string)
MCP_HALLWAY_TOKEN=

# App
# Signs the identity cookie and agent keys (any long random string)
COOKIE_SECRET=
# HTTPS base URL for invite links (the tunnel URL); falls back to the request origin
PUBLIC_URL=
# Person handle that "Use demo profile" signs in as
DEMO_HANDLE=demo
# record = save LLM/scrape responses to data/cache, 1 = replay them, 0 = off
DEMO_CACHE=0
# Base URL for pnpm demo:check
DEMO_BASE_URL=http://localhost:3000

# Google Calendar sign-in (optional; the Google parts hide without it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
