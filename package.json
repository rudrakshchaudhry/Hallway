{
  "name": "hallway",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "seed": "pnpm --filter @hallway/graph --fail-if-no-match seed",
    "test": "vitest run",
    "typecheck": "tsc -p . && pnpm -r typecheck",
    "lint": "eslint .",
    "demo:check": "tsx --env-file-if-exists=.env scripts/demo-check.ts",
    "tunnel": "cloudflared tunnel --url http://localhost:3000"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
